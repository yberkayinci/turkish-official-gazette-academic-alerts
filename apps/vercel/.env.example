# Required platform configuration
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Keep the dollar signs escaped in local dotenv files. Use the unescaped value in Vercel.
ADMIN_PASSWORD_HASH=scrypt\$v1\$16384\$8\$1\$replace-with-salt\$replace-with-derived-key
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ENCRYPTION_KEY=replace-with-a-base64url-encoded-32-byte-key
CRON_SECRET=replace-with-at-least-16-random-characters

# Optional server-side defaults. A key saved in the dashboard overrides its default.
GEMINI_API_KEY=
RESEND_API_KEY=
RESEND_FROM=

# Runtime policy
SESSION_TTL_HOURS=24
# Runtime profile must match the static `vercel.json` selected with
# `npm run cron:hobby` or `npm run cron:pro`. The environment variable does
# not generate or alter Vercel's Cron schedule.
VERCEL_CRON_PROFILE=hobby

# Optional labels shown only after authentication
OWNER_EMAIL=
OWNER_NAME=
